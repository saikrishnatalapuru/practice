locals {
  applications = toset(["backend", "database"])
}

resource "local_file" "app" {
  for_each = local.applications

  filename = "${path.module}/${each.key}.txt"
  content  = "Application: ${each.key}"
}

output "app_filenames" {
  value = {
    for app, file in local_file.app :
    app => file.filename
  }
}